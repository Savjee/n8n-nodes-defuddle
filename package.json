		"release-it": "^19.2.4",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"dependencies": {
		"defuddle": "^0.14.0",
		"jsdom": "^29.0.1"
