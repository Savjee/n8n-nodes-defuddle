{
	"name": "n8n-nodes-defuddle",
	"version": "0.1.0",
	"description": "n8n community node that wraps Defuddle for URL-based content extraction.",
	"license": "MIT",
	"homepage": "https://github.com/Savjee/n8n-nodes-defuddle",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Xavier Decuyper"
	},
	"repository": {
